#!/usr/sbin/nft -f
# {{ ansible_managed }}
# §15 step 1: allow only SSH, HTTP and HTTPS inbound. Everything else, including
# the loopback bind of gunicorn on {{ polls_bind }}, stays local.
flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept

        tcp dport {{ polls_allowed_ssh_port }} accept
        tcp dport 80 accept
        tcp dport 443 accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
