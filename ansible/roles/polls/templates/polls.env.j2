# {{ ansible_managed }}
# Rendered by the polls role, deploy.yml step 5 (§15). Mode 0600, owned by the
# service user. Read by config/settings/prod.py, by contrib/init/polls.service
# and by the job wrapper. Secrets come from ansible-vault, never the repository.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY={{ polls_secret_key }}
# Monitoring and the smoke play hit /sante on the loopback, behind nginx which
# forwards the real Host; both names have to be accepted.
DJANGO_ALLOWED_HOSTS={{ polls_domain }},127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://{{ polls_domain }}
DJANGO_PUBLIC_BASE_URL=https://{{ polls_domain }}
# The database and the job locks live under the state directory, which the
# deploy tag never touches — a redeploy keeps the roll snapshot and the audit
# log (§15).
DJANGO_DB_PATH={{ polls_state_dir }}/db.sqlite3
DJANGO_JOB_LOCK_DIR={{ polls_state_dir }}/locks
# gunicorn loads config.wsgi from the current-release symlink; the project is a
# virtual package (uv.lock), so src has to be on the path explicitly.
PYTHONPATH={{ polls_prefix }}/current/src
# The release tree is read-only to the service (ProtectSystem=strict), so don't
# try to write .pyc caches into it; keep stdout unbuffered for journald.
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
APP_VERSION={{ polls_release }}
DJANGO_LOG_LEVEL={{ polls_log_level }}
DJANGO_FROM_EMAIL={{ polls_from_email | default(polls_admin_email, true) }}
DJANGO_EMAIL_HOST={{ polls_email_host }}
DJANGO_EMAIL_PORT={{ polls_email_port }}
DJANGO_EMAIL_USER={{ polls_email_user }}
DJANGO_EMAIL_PASSWORD={{ polls_email_password }}
