#: src/templates/backoffice/registration_queue.html:46
msgid "Entrées proches de la liste électorale"
msgstr "Close entries in the electoral roll"

#: src/templates/backoffice/registration_queue.html:57
msgid "Choisir l'entrée à rattacher, puis accepter"
msgstr "Choose the entry to link, then accept"

#: src/templates/backoffice/registration_queue.html:60
msgid "Rattacher"
msgstr "Link"

#: src/templates/backoffice/registration_queue.html:65
#: src/templates/backoffice/roll_import_review.html:91
