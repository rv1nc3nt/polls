msgstr[0] "%(n)s first name in common"
msgstr[1] "%(n)s first names in common"

#: src/templates/backoffice/registration_queue.html:96
msgid "Aucune entrée proche. Vérifiez auprès de la personne, ou en mairie."
msgstr "No close entry. Check with the person, or at the mairie."

#: src/templates/backoffice/registration_queue.html:108
msgid ""
"Conservée avec la demande et supprimée avec elle. N'apparaît pas dans le "
"journal d'audit."
msgstr ""
"Kept with the request and deleted with it. Does not appear in the audit log."

#: src/templates/backoffice/registration_queue.html:119
msgid "Accepter"
msgstr "Accept"

#: src/templates/backoffice/registration_queue.html:127
msgid "Accepter et envoyer le lien de vote"
msgstr "Accept and send the voting link"

#: src/templates/backoffice/registration_queue.html:131
#: src/templates/backoffice/registration_queue.html:139
msgid "Refuser"
msgstr "Refuse"

#: src/templates/backoffice/registration_queue.html:144
