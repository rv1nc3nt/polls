# SPDX-License-Identifier: 0BSD
# systemd unit for the web process. Debian is the playbook-installed, CI-tested
# target (§15); this file is what the playbook installs.
#
# No hardcoded paths: everything comes from the environment file, so a
# non-Debian install can point them elsewhere.
[Unit]
Description=Commune polling platform
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=polls
Group=polls
EnvironmentFile=/etc/polls/polls.env
WorkingDirectory=/opt/polls/current
# No --access-logfile: nginx already logs every request (nginx-vhost.conf.j2),
# with the /<lang>/bulletin/ prefix deliberately excluded there because its
# URLs carry a voter's plaintext token (R-7.4 ter). Gunicorn sits behind nginx
# and would log independently of that suppression — its default access-log
# format includes the full request line — so enabling it here would put the
# token in the journal regardless of what the nginx config does.
ExecStart=/opt/polls/current/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 --workers 3 --error-logfile -
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/polls /var/backups/polls
StateDirectory=polls

[Install]
WantedBy=multi-user.target
